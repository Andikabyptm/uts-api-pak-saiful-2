{"info":{"name":"UTS Pemrograman API","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},"item":[{"name":"1-Alur Utama","item":[{"name":"S01 POST kategori","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status 201',()=>pm.response.to.have.status(201));","pm.test('Simpan kategoriId',()=>{const j=pm.response.json();pm.expect(j.status).to.eql('success');pm.expect(j.data.id).to.be.a('number');pm.environment.set('kategoriId',j.data.id)});"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/kategori","body":{"mode":"raw","raw":"{\"nama_kategori\":\"Kategori Uji {{$timestamp}}-{{$randomInt}}\",\"deskripsi\":\"Dibuat oleh Runner\"}","options":{"raw":{"language":"json"}}}}},{"name":"S02 POST produk","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status 201',()=>pm.response.to.have.status(201));","pm.test('Simpan produkId, deleted_at null',()=>{const j=pm.response.json();pm.expect(j.data.deleted_at).to.eql(null);pm.expect(j.data.kategori_id).to.eql(Number(pm.environment.get('kategoriId')));pm.environment.set('produkId',j.data.id)});"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/produk","body":{"mode":"raw","raw":"{\"kategori_id\":{{kategoriId}},\"kode_produk\":\"UJI-{{$timestamp}}-{{$randomInt}}\",\"nama_produk\":\"Produk Uji\",\"harga\":15000,\"stok\":25}","options":{"raw":{"language":"json"}}}}},{"name":"S03 GET produk by id","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status 200',()=>pm.response.to.have.status(200));","pm.test('id sama',()=>pm.expect(pm.response.json().data.id).to.eql(Number(pm.environment.get('produkId'))));"]}}],"request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/produk/{{produkId}}"}},{"name":"S04 GET produk milik kategori","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status 200',()=>pm.response.to.have.status(200));","pm.test('count>=1 dan memuat produk S02',()=>{const j=pm.response.json();const id=Number(pm.environment.get('produkId'));pm.expect(j.count).to.be.at.least(1);pm.expect(j.data.some(p=>p.id===id)).to.eql(true)});"]}}],"request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/kategori/{{kategoriId}}/produk"}},{"name":"S05 PUT produk","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status 200',()=>pm.response.to.have.status(200));","pm.test('Semua field berubah',()=>{const d=pm.response.json().data;pm.expect(d.kode_produk).to.match(/^UJ2-/);pm.expect(d.nama_produk).to.eql('Produk Uji Diperbarui');pm.expect(d.harga).to.eql(20000);pm.expect(d.stok).to.eql(30)});"]}}],"request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/produk/{{produkId}}","body":{"mode":"raw","raw":"{\"kategori_id\":{{kategoriId}},\"kode_produk\":\"UJ2-{{$timestamp}}-{{$randomInt}}\",\"nama_produk\":\"Produk Uji Diperbarui\",\"harga\":20000,\"stok\":30}","options":{"raw":{"language":"json"}}}}},{"name":"S06 PATCH produk stok","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status 200',()=>pm.response.to.have.status(200));","pm.test('Hanya stok berubah',()=>{const d=pm.response.json().data;pm.expect(d.stok).to.eql(40);pm.expect(d.harga).to.eql(20000);pm.expect(d.nama_produk).to.eql('Produk Uji Diperbarui')});"]}}],"request":{"method":"PATCH","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/produk/{{produkId}}","body":{"mode":"raw","raw":"{\"stok\":40}","options":{"raw":{"language":"json"}}}}},{"name":"S07 DELETE produk (soft delete)","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status 204',()=>pm.response.to.have.status(204));","pm.test('Tanpa body',()=>pm.expect(pm.response.text()).to.eql(''));"]}}],"request":{"method":"DELETE","header":[],"url":"{{baseUrl}}/api/produk/{{produkId}}","description":"BUKTI DB #1: jalankan SELECT di pgAdmin, deleted_at harus terisi."}},{"name":"S08 GET produk (404)","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status 404',()=>pm.response.to.have.status(404));","pm.test('Body error',()=>{const j=pm.response.json();pm.expect(j.status).to.eql('error');pm.expect(j.message).to.be.a('string').and.not.empty});"]}}],"request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/produk/{{produkId}}"}},{"name":"S09 GET daftar produk","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status 200',()=>pm.response.to.have.status(200));","pm.test('Tidak memuat produkId',()=>{const j=pm.response.json();const id=Number(pm.environment.get('produkId'));pm.expect(j.data.every(p=>p.id!==id)).to.eql(true)});"]}}],"request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/produk"}},{"name":"S10 PATCH restore","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status 200',()=>pm.response.to.have.status(200));","pm.test('deleted_at null',()=>pm.expect(pm.response.json().data.deleted_at).to.eql(null));"]}}],"request":{"method":"PATCH","header":[],"url":"{{baseUrl}}/api/produk/{{produkId}}/restore","description":"BUKTI DB #2: jalankan SELECT di pgAdmin, deleted_at harus NULL."}},{"name":"S11 GET produk (muncul lagi)","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status 200',()=>pm.response.to.have.status(200));","pm.test('Data muncul lagi',()=>pm.expect(pm.response.json().data.id).to.eql(Number(pm.environment.get('produkId'))));"]}}],"request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/produk/{{produkId}}"}},{"name":"S12 DELETE kategori (409)","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status 409',()=>pm.response.to.have.status(409));","pm.test('Body error',()=>{const j=pm.response.json();pm.expect(j.status).to.eql('error');pm.expect(j.message).to.be.a('string').and.not.empty});"]}}],"request":{"method":"DELETE","header":[],"url":"{{baseUrl}}/api/kategori/{{kategoriId}}"}},{"name":"S13 POST kategori sementara","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status 201',()=>pm.response.to.have.status(201));","pm.test('Simpan kategoriSementaraId',()=>{const j=pm.response.json();pm.expect(j.data.id).to.be.a('number');pm.environment.set('kategoriSementaraId',j.data.id)});"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/kategori","body":{"mode":"raw","raw":"{\"nama_kategori\":\"Sementara {{$timestamp}}-{{$randomInt}}\"}","options":{"raw":{"language":"json"}}}}},{"name":"S14 DELETE kategori sementara (hard delete)","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status 204',()=>pm.response.to.have.status(204));","pm.test('Tanpa body',()=>pm.expect(pm.response.text()).to.eql(''));"]}}],"request":{"method":"DELETE","header":[],"url":"{{baseUrl}}/api/kategori/{{kategoriSementaraId}}","description":"BUKTI DB #3: jalankan SELECT di pgAdmin, baris harus hilang."}},{"name":"S15 GET kategori sementara (404)","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status 404',()=>pm.response.to.have.status(404));","pm.test('Body error',()=>{const j=pm.response.json();pm.expect(j.status).to.eql('error');pm.expect(j.message).to.be.a('string').and.not.empty});"]}}],"request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/kategori/{{kategoriSementaraId}}"}}]},{"name":"2-Skenario Error","item":[{"name":"N01 POST kategori nama kosong (400)","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status 400',()=>pm.response.to.have.status(400));","pm.test('Body error',()=>{const j=pm.response.json();pm.expect(j.status).to.eql('error');pm.expect(j.message).to.be.a('string').and.not.empty});","pm.test('errors terisi',()=>pm.expect(pm.response.json().e